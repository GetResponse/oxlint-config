{
  "name": "@getresponse/oxlint-config",
  "version": "1.2.0",
  "description": "GetResponse Oxlint config",
  "keywords": [
    "config",
    "oxlint",
    "oxlintconfig",
    "getresponse",
    "javascript",
    "typescript",
    "styleguide"
  ],
  "homepage": "https://github.com/getresponse/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/getresponse/oxlint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetResponse/oxlint-config.git"
  },
  "license": "MIT",
  "author": "GetResponse (https://github.com/GetResponse)",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./a11y": {
      "types": "./dist/mixins/a11y.d.ts",
      "default": "./dist/mixins/a11y.js"
    },
    "./mixins/a11y": {
      "types": "./dist/mixins/a11y.d.ts",
      "default": "./dist/mixins/a11y.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:docs",
    "build:ts": "tsc --build",
    "build:docs": "node scripts/buildDocs.mjs",
    "lint": "oxlint",
    "release": "semantic-release",
    "test": "npm run lint",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@getresponse/tsconfig": "2.0.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.0.1",
    "@types/semver": "7.7.1",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "semantic-release": "25.0.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.10.4",
    "eslint-plugin-react": "7.37.5",
    "get-tsconfig": "4.14.0",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0"
  },
  "peerDependenciesMeta": {
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
